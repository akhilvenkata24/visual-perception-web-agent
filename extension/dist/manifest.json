{
  "manifest_version": 3,
  "name": "Privacy Browser Agent",
  "version": "1.0.0",
  "description": "Privacy-Preserving Browser Vision Agent MVP",
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/content.ts-Dbpp9nrG.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "eng.traineddata",
        "*.png",
        "assets/*",
        "assets/content.ts-Dbpp9nrG.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
