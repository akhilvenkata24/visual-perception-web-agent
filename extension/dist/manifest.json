{
  "manifest_version": 3,
  "name": "WebPilot AI — Autonomous Browser Vision Agent",
  "version": "1.0.0",
  "description": "Futuristic AI Web Agent with Three.js-inspired spatial visualization and context-aware privacy",
  "action": {},
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/content.ts-ByoL2jLB.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle",
      "css": [
        "assets/content-DGxEgi-b.css"
      ]
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "eng.traineddata",
        "*.png",
        "assets/*",
        "assets/content.ts-ByoL2jLB.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
